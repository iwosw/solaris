{
  "id": "plugin-heavy",
  "description": "Real deployed settlements WASM creates the durable lowercase-named load_matrix settlement and repeatedly handles settlement info/list/site/survey commands; no plugin publication",
  "fixture": "plugin-heavy",
  "plugin_required": true,
  "clients": 16,
  "view_distance": 6,
  "spacing": 256,
  "group_size": 16,
  "warmup_ticks": 200,
  "measure_ticks": 1200,
  "client_args": [
    "--no-edits"
  ],
  "commands": {
    "setup": [
      "settlement create load_matrix large"
    ],
    "recurring": [
      {
        "every_ticks": 20,
        "commands": [
          "settlement list",
          "settlement info load_matrix",
          "settlement site load_matrix",
          "settlement survey load_matrix plot"
        ]
      }
    ]
  },
  "activity_requirements": [
    {
      "source": "bots",
      "path": "commands_sent",
      "minimum_delta": 20
    },
    {
      "source": "bots",
      "path": "command_feedback_received",
      "minimum_delta": 20
    }
  ]
}
