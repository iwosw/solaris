// Physical owned inventories and their atomic transfer/reservation lifecycle.
//
// An endpoint names physical inventory: a player's canonical inventory, a
// container's dimension and block position, or a durable npc's equipment
// and carry. Product names and their binding to containers live in plugin storage.
//
// Every operation is a request: the host converts the record into the server's
// own `mc_script` DTO, that DTO's validator re-checks every bound, and the effect
// is performed by the server's own inventory owner - never by a coordinator of
// this contract. The answer arrives later as `events.operation-answered`, carrying
// the family result this interface names.
//
interface inventories {
    use types.{block-position, npc-execution-permit, position};

    record container-endpoint {
        dimension: string,
        position: block-position,
    }

    /// One endpoint of an owned inventory.
    ///
    /// `player-inventory` carries the runtime player id (nonzero, at most
    /// `mc_script::MAX_SCRIPT_WORLD_TIME`), the same id an event's session names,
    /// so a player endpoint is refused for a connection that has ended rather than
    /// reaching whoever holds that id now. `container` addresses a real native
    /// block inventory; native ownership, protection and image fences apply.
    /// `npc-equipment` and `npc-carry` carry one durable npc handle,
    /// 1..`mc_script::MAX_NPC_HANDLE_BYTES` (64) bytes, and stay opaque: the
    /// npc owner resolves them, and a foreign, absent or released handle is a
    /// typed refusal rather than an empty inventory.
    variant inventory-endpoint {
        player-inventory(u64),
        container(container-endpoint),
        npc-equipment(string),
        npc-carry(string),
    }

    /// The durable revision of one endpoint plus a derived canonical before-image
    /// hash.
    ///
    /// `snapshot-hash` is exactly 64 lowercase hexadecimal bytes, the digest of the
    /// canonical inventory image the revision describes, so a plugin cannot name a
    /// revision it did not read. `revision` is at most
    /// `mc_script::MAX_SCRIPT_WORLD_TIME`.
    record inventory-fence {
        revision: u64,
        snapshot-hash: string,
    }

    /// One endpoint and the fence a mutation expects it to still be at.
    record inventory-expected-revision {
        endpoint: inventory-endpoint,
        fence: inventory-fence,
    }

    /// One move of items from one endpoint slot to another.
    ///
    /// `count` is 1..`i32::MAX`, and at most
    /// `mc_script::MAX_OWNED_INVENTORY_ITEM_BUDGET` (4096) items may move across
    /// all transfers of one request. A slot is the endpoint's own canonical index:
    /// a player slot is 9..=44, a container slot is below
    /// `mc_script::MAX_OWNED_INVENTORY_SLOTS` (54), a npc equipment slot is
    /// below `mc_script::MAX_NPC_EQUIPMENT_SLOTS` (6), and a npc carry
    /// slot is below `mc_script::MAX_NPC_CARRY_SLOTS` (8).
    record owned-item-transfer {
        source: inventory-endpoint,
        source-slot: u8,
        destination: inventory-endpoint,
        destination-slot: u8,
        count: u32,
    }

    /// One resource and how many units of it a reservation asks for.
    record inventory-material {
        resource-id: string,
        quantity: u64,
    }

    /// One work portion of a resource plan: a number of work units and the
    /// materials it consumes, with `materials` sorted by resource id and free of
    /// duplicates.
    record inventory-work-portion {
        work-units: u64,
        materials: list<inventory-material>,
    }

    /// What one reservation holds, in work portions.
    ///
    /// A plan carries 1..`mc_script::MAX_INVENTORY_WORK_PORTIONS` (512) portions;
    /// each portion has 1..`mc_script::MAX_SCRIPT_WORLD_TIME` work units and at
    /// most `mc_script::MAX_INVENTORY_RESOURCE_TYPES` (16) materials; each
    /// material quantity is 1..`mc_script::MAX_SCRIPT_WORLD_TIME`; and the whole
    /// plan names at most `mc_script::MAX_INVENTORY_RESOURCE_TYPES` (16) distinct
    /// resources. The server's own plan validator is what enforces all of them.
    record inventory-resource-plan {
        portions: list<inventory-work-portion>,
    }

    /// One read of one endpoint, optionally fenced to a revision.
    ///
    /// A query carries no durable operation id: it changes nothing and creates no
    /// receipt, so the answer's `operation-id` is absent rather than invented. An
    /// `expected-revision` the endpoint has moved past is answered with the typed
    /// `stale-revision` refusal instead of the snapshot.
    record inventory-query {
        endpoint: inventory-endpoint,
        expected-revision: option<u64>,
    }

    /// Read-only exact room for the ACTUAL positive source component stack.
    /// Both full fences and native access rights are checked live. No permit,
    /// reservation or mutation is granted by this answer; later transfers still
    /// require their current execution permit and all full native fences.
    record inventory-placement-query {
        source: inventory-expected-revision,
        source-slot: u8,
        destination: inventory-expected-revision,
    }

    /// One move of items between owned endpoints, under one durable operation id.
    ///
    /// A player endpoint requires the exact participating runtime player id;
    /// any other player's inventory is refused `forbidden`. `actor-id` is zero
    /// only for a server-owned container-to-npc move with no player endpoint:
    /// native container access and npc ownership are checked freshly.
    /// Up to `mc_script::MAX_OWNED_INVENTORY_TRANSFERS` (16) transfers and twice
    /// that many expected revisions name exactly the participating endpoints,
    /// sorted by endpoint. `operation-id` is the durable name the server records
    /// under: repeating byte-identical content replays its outcome without
    /// applying it again, and different content is `operation-conflict`.
    record inventory-transfer {
        /// 1..`mc_script::MAX_SCRIPT_ID_BYTES` (64) bytes of lowercase letters,
        /// digits, `_` and `-`.
        operation-id: string,
        actor-id: u64,
        execution-permit: option<npc-execution-permit>,
        transfers: list<owned-item-transfer>,
        expected-revisions: list<inventory-expected-revision>,
    }

    /// One durable reservation of materials held against one endpoint.
    ///
    /// The fence is the endpoint's own `inventory-fence`; a reservation whose
    /// expected revision has moved is refused rather than reserved against the
    /// wrong image. The plan is the server's own validated plan, and a
    /// reservation against a container endpoint fences its real canonical image
    /// and protects the reserved quantity from competing physical transfers.
    record inventory-reserve {
        /// 1..`mc_script::MAX_SCRIPT_ID_BYTES` (64) bytes, as in
        /// `inventory-transfer`.
        operation-id: string,
        endpoint: inventory-endpoint,
        resource-plan: inventory-resource-plan,
        expected-revision: inventory-fence,
    }

    record inventory-reservation-status {
        reservation-ref: string,
    }

    record inventory-release {
        operation-id: string,
        reservation-ref: string,
        expected-revision: u64,
    }

    record inventory-consume-reservation {
        operation-id: string,
        actor-id: u64,
        reservation-ref: string,
        execution-permit: option<npc-execution-permit>,
        expected-reservation-revision: u64,
        /// One-based original plan index of the next material-bearing portion.
        /// Material-free work stages grant no execution or progress here.
        portion: u64,
        resource-plan: inventory-resource-plan,
        transfers: list<owned-item-transfer>,
        expected-revisions: list<inventory-expected-revision>,
    }

    /// One owned-inventory operation.
    variant inventory-operation {
        query(inventory-query),
        transfer(inventory-transfer),
        consume-reservation(inventory-consume-reservation),
        reserve(inventory-reserve),
        reservation-status(inventory-reservation-status),
        release(inventory-release),
        placement-room(inventory-placement-query),
    }

    /// One enchantment of one item stack.
    record inventory-enchantment {
        resource-id: string,
        level: s32,
    }

    record inventory-stew-effect { id: string, duration: s32 }

    /// One item stack, components included.
    ///
    /// `damage` and `custom-name` are absent when the stack carries neither, and
    /// `item-model` is the resource id the stack overrides its model with. Every
    /// resource id here is a contract resource id, and `count` is
    /// 1..`i32::MAX`.
    record inventory-item {
        resource-id: string,
        count: u32,
        damage: option<s32>,
        enchantments: list<inventory-enchantment>,
        custom-name: option<string>,
        item-model: option<string>,
        max-damage: option<u32>,
        custom-data: option<list<u8>>,
        stew-effects: list<inventory-stew-effect>,
    }

    enum npc-death-inventory { carry, equipment }
    record npc-death-loot {
        inventory: npc-death-inventory,
        slot: u16,
        entity-uuid: string,
        item: inventory-item,
    }
    /// Exact native physical loot after a canonical cargo death decision.
    record npc-death-cargo-receipt {
        receipt-ref: string,
        handle: string,
        entity-uuid: string,
        dimension: string,
        position: position,
        yaw: f32,
        pitch: f32,
        death-tick: u64,
        source-inventory-revision: u64,
        executor-epoch: option<u64>,
        world-decision-id: u64,
        loot: list<npc-death-loot>,
    }

    /// One occupied or empty slot of a snapshot. An absent `item` is an empty
    /// slot, not an item the plugin may not read.
    record inventory-slot {
        slot: u8,
        item: option<inventory-item>,
    }

    /// The whole canonical image of one endpoint at one revision.
    ///
    /// `slots` holds at most `mc_script::MAX_OWNED_INVENTORY_SLOTS` (54) entries,
    /// each on a distinct slot index the endpoint's own bounds admit, and the
    /// endpoint is the one the query named: the answer never substitutes a
    /// different container for the one asked about.
    record owned-inventory-snapshot {
        endpoint: inventory-endpoint,
        fence: inventory-fence,
        slots: list<inventory-slot>,
    }

    /// One resource a reservation holds, and where its units went.
    ///
    /// `reserved` is `consumed + returned + remaining`, and a released
    /// reservation has `remaining` zero: the server's own reservation validator is
    /// what enforces both.
    record inventory-reservation-quantity {
        resource-id: string,
        reserved: u64,
        consumed: u64,
        returned: u64,
        remaining: u64,
    }

    /// The whole state of one durable reservation.
    ///
    /// `reservation-ref` is 1..64 bytes; `resource-plan-hash` is exactly 64
    /// lowercase hexadecimal bytes; `quantities` holds at most
    /// `mc_script::MAX_INVENTORY_RESOURCE_TYPES` (16) entries, sorted by resource
    /// id; `bound-to` is the opaque binding the reservation was made for, when it
    /// has one; and `receipt-watermark` is the last original material-bearing
    /// plan portion consumed by a reserved transfer (zero before consumption).
    /// The state round-trips on a later read rather than being re-derived.
    record inventory-reservation-snapshot {
        reservation-ref: string,
        endpoint: inventory-endpoint,
        resource-plan-hash: string,
        quantities: list<inventory-reservation-quantity>,
        bound-to: option<string>,
        released: bool,
        receipt-watermark: u64,
    }

    record inventory-reserved-transfer {
        reservation: inventory-reservation-snapshot,
        inventories: list<owned-inventory-snapshot>,
    }

    record inventory-placement-slot {
        slot: u8,
        /// Exact native slot capacity, independent of the source count.
        room: u32,
    }

    /// Every actual destination slot, including zero-room slots, bounded by
    /// MAX_OWNED_INVENTORY_SLOTS (54). Components/native item facts and the
    /// existing native placement window decide room, never guest-supplied limits.
    record inventory-placement-room {
        source: inventory-expected-revision,
        source-slot: u8,
        destination: inventory-expected-revision,
        slots: list<inventory-placement-slot>,
    }

    /// The typed answer to one owned-inventory operation.
    ///
    /// The variants are the server's own result, one for one: a query answers the
    /// endpoint's whole snapshot, a transfer answers the resulting fence of every
    /// endpoint it touched - sorted by endpoint, which is what a later transfer
    /// fences against - and a reservation answers its whole reservation state.
    variant inventory-result {
        snapshot(owned-inventory-snapshot),
        transfer(list<inventory-expected-revision>),
        reservation(inventory-reservation-snapshot),
        reserved-transfer(inventory-reserved-transfer),
        placement-room(inventory-placement-room),
    }
}
