// Native settlement customization surface (D006 S1 records, S2 households, S3 districts, S4 economy).
//
// A new interface rather than members stuffed into `npcs`: settlement records
// are the native registry's own rows (stable id plus name/optional owner/anchor/
// radius/revision plus a derived member count and derived household
// snapshots), and the actions are the closed mutations
// (bind/unbind/rename/form-household/relocate-household/plan-district/economy) fenced
// by the record id AND the revision the caller read. Name plus revision alone
// is not enough: after remove/recreate the name and revision 1 repeat while
// the id never does (ABA), so every action targets the stable id. A district
// plan binds requested branch/level and certified building refs; queries
// derive live housing/population/certified-container food/working purposes.
// S4 economy actions are closed typed mutations (production/employment/quote/
// escrow/caravan) with shape-only DTO validation; native stock, bodies and
// poses stay in the parent owner.
interface settlements {
    use types.{block-position};
    /// One bounded settlement query. Empty names read one bounded page of
    /// visible records; explicit names must each be valid registry names.
    record query-settlement {
        names: list<string>,
        cursor: option<string>,
    }

    /// One derived household snapshot: the stable `<settlement>-<sequence>`
    /// id, the household revision, the origin snake-case string
    /// (`adoption`/`migration`/`split`/`refugee`), the social home anchor
    /// (absent while unset), the needs/policy references (absent while unset),
    /// and the living current-dimension member entity UUIDs. A derived
    /// occupancy projection, never a second membership authority.
    record household-snapshot {
        id: string,
        revision: u64,
        origin: string,
        home-x: option<s32>,
        home-y: option<s32>,
        home-z: option<s32>,
        needs: option<string>,
        policy: option<string>,
        members: list<string>,
    }

    /// One certified native building bound to a district plan: the certificate
    /// family (`structure` or `worksite`), the durable native structure id,
    /// and the certified resource id it serves.
    record district-building-ref {
        kind: string,
        id: string,
        purpose: string,
    }

    /// One live district observation: the requested branch/level plus the
    /// certified refs, and the derived observation (stage, certified
    /// branch/level, live housing/population, certified-container food,
    /// working purposes, optional reason, observation ticks).
    record district-snapshot {
        requested-branch: string,
        requested-level: u8,
        stage: option<string>,
        branch: string,
        level: u8,
        population: u32,
        housed: u32,
        food: u64,
        working: list<string>,
        reason: option<string>,
        observed-tick: u64,
        world-revision: u64,
        buildings: list<district-building-ref>,
    }

    /// One detached settlement snapshot: the stable id, the native registry
    /// fields, the derived local member count (an occupancy projection,
    /// never a second membership authority), the derived household snapshots,
    /// plus the live district observation when planned. The id is what later
    /// actions fence on: names are reusable, ids never are.
    record settlement-snapshot {
        id: u64,
        name: string,
        /// Absent for an autonomous, unclaimed generated village.
        owner: option<string>,
        anchor-x: s32,
        anchor-y: s32,
        anchor-z: s32,
        radius: u32,
        revision: u64,
        member-count: u32,
        households: list<household-snapshot>,
        district: option<district-snapshot>,
        economy: option<economy-snapshot>,
    }

    /// One bounded page of settlement snapshots.
    record settlement-page {
        settlements: list<settlement-snapshot>,
        cursor: option<string>,
    }

    /// Bind one resident villager (by native entity UUID) to the settlement
    /// id the query observed, fenced by that record's revision.
    record bind-settlement {
        operation-id: string,
        settlement: u64,
        entity-uuid: string,
        expected-revision: u64,
    }

    /// Release one resident villager (by native entity UUID) from the
    /// settlement id the query observed. A recreated same-name record never
    /// matches a stale request.
    record unbind-settlement {
        operation-id: string,
        settlement: u64,
        entity-uuid: string,
        expected-revision: u64,
    }

    /// Rename the settlement id the query observed, fenced by its revision.
    /// The id survives the rename; the answer carries both.
    record rename-settlement {
        operation-id: string,
        settlement: u64,
        new-name: string,
        expected-revision: u64,
    }

    /// Form one household of already-bound resident villagers (by native
    /// entity UUIDs) in the settlement id the query observed, fenced by that
    /// record's revision. The origin is always `adoption` on this surface.
    record form-household {
        operation-id: string,
        settlement: u64,
        entity-uuids: list<string>,
        expected-revision: u64,
    }

    /// Move one household by its stable id from the source settlement id the
    /// query observed to the destination settlement, fenced by both records'
    /// revisions. The household id survives the move; members keep living
    /// UUIDs and gain the destination settlement column.
    record relocate-household {
        operation-id: string,
        settlement: u64,
        expected-revision: u64,
        household: string,
        destination: u64,
        expected-destination-revision: u64,
    }

    /// Plan one native district on the settlement id the query observed,
    /// fenced by that record's revision. The plan binds requested
    /// branch/level and certified building refs; the query later derives the
    /// live observation.
    record plan-district {
        operation-id: string,
        settlement: u64,
        expected-revision: u64,
        branch: string,
        level: u8,
        buildings: list<district-building-ref>,
    }

    /// One native economic inventory endpoint: exact living carry/equipment
    /// bodies by UUID, exact native containers by position (the server
    /// infers the current dimension), or the native owner player by UUID.
    variant economic-inventory-endpoint {
        carry(string),
        equipment(string),
        container(block-position),
        player(string),
    }

    /// Start one production job: the script id, the living worker UUID, the
    /// work recipe, the portion count, the certified building, the live
    /// station cell and the worker stand post.
    record production-start {
        job: string,
        worker: string,
        recipe: string,
        count: u32,
        building: district-building-ref,
        station: block-position,
        stand-at: block-position,
    }

    /// Hire one worker against a treasury endpoint.
    record employ {
        contract: string,
        worker: string,
        treasury: economic-inventory-endpoint,
        wage: u32,
        period: u64,
        budget: u64,
    }

    /// Offer one physical quote: the seller slot cited by index, the unit
    /// count and the total emerald price.
    record quote {
        id: string,
        seller: economic-inventory-endpoint,
        buyer: economic-inventory-endpoint,
        source-slot: u16,
        quantity: u32,
        price: u32,
    }

    /// Reserve money escrow for one caravan shipment.
    record escrow-reserve {
        id: string,
        shipment: string,
        payer: economic-inventory-endpoint,
        escrow: economic-inventory-endpoint,
        payee: economic-inventory-endpoint,
        price: u32,
    }

    /// Open one physical caravan shipment between certified containers.
    record caravan-open {
        id: string,
        carrier: string,
        source-building: district-building-ref,
        source-position: block-position,
        destination-building: district-building-ref,
        destination-position: block-position,
        source-slot: u16,
        quantity: u32,
        waypoints: list<block-position>,
        max-ticks: u64,
        paid-mandate: option<string>,
    }

    /// Block one shipment with a short terminal reason.
    record caravan-block {
        id: string,
        reason: string,
    }

    /// One closed typed economic action. Single-id arms carry the id
    /// directly; multi-field arms use the records above.
    variant economy-action {
        production-start(production-start),
        production-pause(string),
        production-resume(string),
        production-cancel(string),
        employ(employ),
        stop-employment(string),
        dismiss-employment(string),
        pay(string),
        quote(quote),
        accept-quote(string),
        cancel-quote(string),
        escrow-reserve(escrow-reserve),
        escrow-payout(string),
        caravan-open(caravan-open),
        caravan-pickup(string),
        caravan-unload(string),
        caravan-cancel(string),
        caravan-block(caravan-block),
    }

    /// One typed economic mutation on the settlement id the query observed,
    /// fenced by that record's revision.
    record economy-settlement {
        operation-id: string,
        settlement: u64,
        expected-revision: u64,
        action: economy-action,
    }

    /// One closed settlement mutation.
    variant settlement-operation {
        bind(bind-settlement),
        unbind(unbind-settlement),
        rename(rename-settlement),
        form-household(form-household),
        relocate-household(relocate-household),
        plan-district(plan-district),
        economy(economy-settlement),
    }

    /// One live production job observation.
    record production-snapshot {
        id: string,
        worker: string,
        recipe: string,
        recipe-revision: string,
        requested: u32,
        completed: u32,
        paused: option<string>,
        cancelled: bool,
        next-due: u64,
    }

    /// One live employment observation.
    record employment-snapshot {
        id: string,
        worker: string,
        treasury: economic-inventory-endpoint,
        wage: u32,
        period: u64,
        budget: u64,
        earned: u64,
        paid: u64,
        active: bool,
        next-due: u64,
    }

    /// One pending quote observation (read-only item summary).
    record quote-snapshot {
        id: string,
        seller: economic-inventory-endpoint,
        buyer: economic-inventory-endpoint,
        item-id: string,
        quantity: u32,
        price: u32,
    }

    /// One live escrow mandate observation (`escrowed`/`lost`); paid IDs retire.
    record mandate-snapshot {
        id: string,
        shipment: string,
        payer: economic-inventory-endpoint,
        escrow: economic-inventory-endpoint,
        payee: economic-inventory-endpoint,
        price: u32,
        status: string,
    }

    /// One caravan shipment observation (read-only item summary).
    record shipment-snapshot {
        id: string,
        carrier: string,
        source: economic-inventory-endpoint,
        destination: economic-inventory-endpoint,
        item-id: string,
        quantity: u32,
        stage: string,
        waypoint: u32,
        waypoints: list<block-position>,
        blocked: option<string>,
        paid-mandate: option<string>,
    }

    /// One settlement's live economic observation plus replay watermarks.
    record economy-snapshot {
        production: list<production-snapshot>,
        employments: list<employment-snapshot>,
        quotes: list<quote-snapshot>,
        mandates: list<mandate-snapshot>,
        shipments: list<shipment-snapshot>,
        ended-employment: u64,
        completed-quote: u64,
        settled-mandate: u64,
    }

    /// The affected record's stable id plus its current name (the name
    /// survives renames; the id is stable).
    record settlement-mutation {
        id: u64,
        name: string,
    }

    /// The server's one settlement page, or the affected record's id+name.
    variant settlement-result {
        page(settlement-page),
        changed(settlement-mutation),
    }
}
